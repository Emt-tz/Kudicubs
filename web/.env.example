# Local Supabase (run `supabase start` in the repo root). Only the anon key ever reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-ANON_KEY-from-supabase-status
# Lets ?state=loading|empty|error|offline open each designed state. Set to 0 in production.
NEXT_PUBLIC_DEMO_STATES=1
