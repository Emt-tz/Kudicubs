{
  "$schema": "../../specs/002-ux-prototype/contracts/tokens.schema.json",
  "version": "0.1.0",
  "color": {
    "sand": {
      "50": { "$value": "#FFF6E8", "$type": "color", "$description": "App background: sun-washed sand. Default page colour for every child screen." },
      "100": { "$value": "#FCE9CC", "$type": "color", "$description": "Cards, panels and tray backgrounds on top of sand.50." },
      "200": { "$value": "#F3D9B1", "$type": "color", "$description": "Desk colour around the phone frame on large screens; dividers on cards. Not for text backgrounds." }
    },
    "gold": {
      "500": { "$value": "#F0A830", "$type": "color", "$description": "PRIMARY. Kudi's mane, main buttons, coins. Always pair with cocoa.900 text, never white." },
      "600": { "$value": "#D98A12", "$type": "color", "$description": "Primary pressed state, button bottom edge, coin rims. Never as a text background with white." }
    },
    "cocoa": {
      "900": { "$value": "#3A2315", "$type": "color", "$description": "Main text and text on gold surfaces." },
      "700": { "$value": "#6B4A33", "$type": "color", "$description": "Secondary text, captions on sand." },
      "500": { "$value": "#8A6A52", "$type": "color", "$description": "Locked and 'coming soon' icons and large labels. Large text or icons only." }
    },
    "terracotta": {
      "600": { "$value": "#B04A26", "$type": "color", "$description": "Market accent: awnings, highlights, accent chips. Never an error colour." }
    },
    "indigo": {
      "700": { "$value": "#2B3A75", "$type": "color", "$description": "Adire indigo: the parent area, the parent gate and the reviewer menu. Signals 'grown-up space'." },
      "100": { "$value": "#DDE2F7", "$type": "color", "$description": "Secondary text and outlines on indigo.700 surfaces." }
    },
    "green": {
      "700": { "$value": "#1F6B45", "$type": "color", "$description": "Positive outcomes and savings (deep leaf green; deliberately not a bright lime)." }
    },
    "teal": {
      "700": { "$value": "#0F6670", "$type": "color", "$description": "Narration speaker cue and information accents." }
    },
    "hibiscus": {
      "600": { "$value": "#C23B5A", "$type": "color", "$description": "Celebration accent and badges. NEVER used to signal a mistake." }
    },
    "white": { "$value": "#FFFFFF", "$type": "color", "$description": "Text on dark accent surfaces; card surfaces inside the parent area." },
    "bg": {
      "app": { "$value": "{color.sand.50}", "$type": "color", "$description": "Semantic: page background for child screens." },
      "card": { "$value": "{color.sand.100}", "$type": "color", "$description": "Semantic: card and tray background." },
      "desk": { "$value": "{color.sand.200}", "$type": "color", "$description": "Semantic: area around the phone frame on large screens." }
    },
    "text": {
      "primary": { "$value": "{color.cocoa.900}", "$type": "color", "$description": "Semantic: main text." },
      "secondary": { "$value": "{color.cocoa.700}", "$type": "color", "$description": "Semantic: secondary text." },
      "locked": { "$value": "{color.cocoa.500}", "$type": "color", "$description": "Semantic: locked/coming-soon labels (large text only)." },
      "on_dark": { "$value": "{color.white}", "$type": "color", "$description": "Semantic: text on indigo, green, terracotta, teal or hibiscus." }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.gold.500}", "$type": "color", "$description": "Semantic: main button fill." },
        "edge": { "$value": "{color.gold.600}", "$type": "color", "$description": "Semantic: main button bottom edge and pressed fill." },
        "fg": { "$value": "{color.cocoa.900}", "$type": "color", "$description": "Semantic: main button label." }
      }
    },
    "feedback": {
      "positive": { "$value": "{color.green.700}", "$type": "color", "$description": "Semantic: good outcome, savings growing." },
      "gentle": { "$value": "{color.teal.700}", "$type": "color", "$description": "Semantic: gentle redirect and hint ring. There is NO error colour on child screens." }
    },
    "parent": {
      "bg": { "$value": "{color.indigo.700}", "$type": "color", "$description": "Semantic: parent gate and reviewer menu background." },
      "fg": { "$value": "{color.white}", "$type": "color", "$description": "Semantic: text on the parent background." },
      "muted": { "$value": "{color.indigo.100}", "$type": "color", "$description": "Semantic: secondary text on the parent background." }
    },
    "celebrate": { "$value": "{color.hibiscus.600}", "$type": "color", "$description": "Semantic: celebration accent." }
  },
  "font": {
    "display": { "$value": "'Baloo 2', 'Nunito', system-ui, sans-serif", "$type": "fontFamily", "$description": "Titles, numbers and buttons (OFL)." },
    "body": { "$value": "'Nunito', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body text and labels (OFL)." }
  },
  "typography": {
    "display_xl": { "$value": { "fontFamily": "{font.display}", "fontWeight": 800, "fontSize": "40px", "lineHeight": 1.1 }, "$type": "typography", "$description": "Big counting numerals and Welcome title." },
    "display_l": { "$value": { "fontFamily": "{font.display}", "fontWeight": 800, "fontSize": "32px", "lineHeight": 1.15 }, "$type": "typography", "$description": "Reward amounts, Level Up." },
    "title": { "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "26px", "lineHeight": 1.2 }, "$type": "typography", "$description": "Screen titles." },
    "button_4_6": { "$value": { "fontFamily": "{font.display}", "fontWeight": 800, "fontSize": "24px", "lineHeight": 1.1 }, "$type": "typography", "$description": "Main button label for ages 4–6 (≥ 22 pt, FR-003)." },
    "button": { "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "20px", "lineHeight": 1.1 }, "$type": "typography", "$description": "Main button label for older bands and parent screens." },
    "body_child": { "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "20px", "lineHeight": 1.35 }, "$type": "typography", "$description": "Child-facing body text (≥ 18 pt)." },
    "body": { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.4 }, "$type": "typography", "$description": "Default body text." },
    "label": { "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "16px", "lineHeight": 1.3 }, "$type": "typography", "$description": "Labels under icons, chips (child screens use with an icon)." },
    "caption": { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.35 }, "$type": "typography", "$description": "Parent and reviewer screens only. Never on child screens." }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension", "$description": "Hairline gaps (icon to label)." },
    "2": { "$value": "8px", "$type": "dimension", "$description": "Tight gaps inside components." },
    "3": { "$value": "12px", "$type": "dimension", "$description": "Small gaps between related items." },
    "4": { "$value": "16px", "$type": "dimension", "$description": "Default gap and screen side padding." },
    "5": { "$value": "20px", "$type": "dimension", "$description": "Card padding." },
    "6": { "$value": "24px", "$type": "dimension", "$description": "Gap between sections." },
    "8": { "$value": "32px", "$type": "dimension", "$description": "Large gap above the main action." },
    "10": { "$value": "40px", "$type": "dimension", "$description": "Hero spacing." },
    "12": { "$value": "48px", "$type": "dimension", "$description": "Extra large spacing." },
    "16": { "$value": "64px", "$type": "dimension", "$description": "Very large spacing (Welcome)." }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension", "$description": "Chips, small tags." },
    "md": { "$value": "16px", "$type": "dimension", "$description": "Cards, choice cards." },
    "lg": { "$value": "24px", "$type": "dimension", "$description": "Main buttons, panels." },
    "xl": { "$value": "32px", "$type": "dimension", "$description": "Phone frame, sheets." },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Pills, round icon buttons, progress bars." }
  },
  "elevation": {
    "1": { "$value": "0 2px 6px rgba(58, 35, 21, 0.12)", "$type": "shadow", "$description": "Cards resting on sand." },
    "2": { "$value": "0 6px 16px rgba(58, 35, 21, 0.16)", "$type": "shadow", "$description": "Raised choice cards, selected state." },
    "3": { "$value": "0 18px 48px rgba(58, 35, 21, 0.28)", "$type": "shadow", "$description": "Phone frame on large screens, reviewer sheet." }
  },
  "size": {
    "touch": {
      "min": { "$value": "48px", "$type": "dimension", "$description": "Minimum touch target for any interactive element (SC-004)." },
      "primary_4_6": { "$value": "64px", "$type": "dimension", "$description": "Minimum size of a main action for ages 4–6." }
    },
    "button": {
      "height": { "$value": "64px", "$type": "dimension", "$description": "Main button height (7–12)." },
      "height_4_6": { "$value": "76px", "$type": "dimension", "$description": "Main button height for ages 4–6." }
    },
    "kudi": {
      "min": { "$value": "96px", "$type": "dimension", "$description": "Smallest Kudi the Cub may be drawn." },
      "hero": { "$value": "220px", "$type": "dimension", "$description": "Kudi on Welcome, Intro and Reward." }
    },
    "coin": { "$value": "56px", "$type": "dimension", "$description": "Coin token in activities (also its touch size)." },
    "frame": {
      "width": { "$value": "390px", "$type": "dimension", "$description": "Phone frame width on large screens." },
      "height": { "$value": "844px", "$type": "dimension", "$description": "Phone frame height on large screens." }
    }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration", "$description": "Tap feedback." },
    "base": { "$value": "240ms", "$type": "duration", "$description": "Screen and state transitions." },
    "celebrate": { "$value": "1200ms", "$type": "duration", "$description": "Celebration bursts." }
  },
  "pairs": [
    { "fg": "{color.cocoa.900}", "bg": "{color.sand.50}", "usage": "Body text on the app background", "minRatio": 4.5 },
    { "fg": "{color.cocoa.700}", "bg": "{color.sand.50}", "usage": "Secondary text on the app background", "minRatio": 4.5 },
    { "fg": "{color.cocoa.900}", "bg": "{color.sand.100}", "usage": "Text on cards", "minRatio": 4.5 },
    { "fg": "{color.cocoa.700}", "bg": "{color.sand.100}", "usage": "Secondary text on cards", "minRatio": 4.5 },
    { "fg": "{color.cocoa.500}", "bg": "{color.sand.100}", "usage": "Locked / coming soon labels and icons (large only)", "minRatio": 3 },
    { "fg": "{color.cocoa.900}", "bg": "{color.gold.500}", "usage": "Main button label", "minRatio": 4.5 },
    { "fg": "{color.cocoa.900}", "bg": "{color.gold.600}", "usage": "Main button label, pressed", "minRatio": 4.5 },
    { "fg": "{color.white}", "bg": "{color.indigo.700}", "usage": "Parent gate and reviewer menu text", "minRatio": 4.5 },
    { "fg": "{color.indigo.100}", "bg": "{color.indigo.700}", "usage": "Secondary text on parent surfaces", "minRatio": 4.5 },
    { "fg": "{color.white}", "bg": "{color.terracotta.600}", "usage": "Accent chips", "minRatio": 4.5 },
    { "fg": "{color.white}", "bg": "{color.green.700}", "usage": "Savings and positive badges", "minRatio": 4.5 },
    { "fg": "{color.white}", "bg": "{color.teal.700}", "usage": "Speaker cue icon and hint labels", "minRatio": 4.5 },
    { "fg": "{color.white}", "bg": "{color.hibiscus.600}", "usage": "Celebration labels", "minRatio": 4.5 },
    { "fg": "{color.terracotta.600}", "bg": "{color.sand.50}", "usage": "Accent text on the app background", "minRatio": 4.5 },
    { "fg": "{color.green.700}", "bg": "{color.sand.50}", "usage": "Positive text (+coins, saved)", "minRatio": 4.5 },
    { "fg": "{color.teal.700}", "bg": "{color.sand.50}", "usage": "Speaker cue outline and hint ring", "minRatio": 3 },
    { "fg": "{color.indigo.700}", "bg": "{color.sand.50}", "usage": "Reviewer notes and links", "minRatio": 4.5 },
    { "fg": "{color.cocoa.900}", "bg": "{color.white}", "usage": "Text on white parent-area cards and inputs", "minRatio": 4.5 },
    { "fg": "{color.cocoa.900}", "bg": "{color.sand.200}", "usage": "Text on the desk area around the frame", "minRatio": 4.5 }
  ]
}
