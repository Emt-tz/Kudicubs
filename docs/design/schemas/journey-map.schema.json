{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey-map.schema.json",
  "title": "KudiCubs journey and story map",
  "description": "Contract 1.0.0 for docs/design/journey-map.json. Spec FR-001 to FR-004.",
  "type": "object",
  "required": ["version", "stories", "rows"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "stories": {
      "description": "Every story id that must appear in at least one row (001-US1..6 and 005-US1..9).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(001|005)-US[0-9]+$" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "platform": { "enum": ["app", "website", "parent-dashboard", "team-console", "hub"] },
    "state": { "enum": ["default", "loading", "empty", "error", "success", "disabled", "focus"] },
    "screenLink": {
      "type": "object",
      "required": ["platform", "screen"],
      "additionalProperties": false,
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "screen": { "type": "string", "minLength": 1 },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" }, "uniqueItems": true }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "source", "platform", "actor", "title", "priority", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^J-(APP|WEB|PD|TC|HUB)-[0-9]{2,3}$" },
        "source": { "type": "string", "pattern": "^(001|005)-US[0-9]+$" },
        "platform": { "$ref": "#/$defs/platform" },
        "actor": {
          "enum": ["child-4-6", "child-7-9", "child-10-12", "child-13-15", "parent", "visitor", "support", "content-editor", "reviewer"]
        },
        "title": { "type": "string", "minLength": 3 },
        "priority": { "enum": ["P1", "P2", "P3"] },
        "status": { "enum": ["designed", "gap", "out-of-scope"] },
        "screens": { "type": "array", "items": { "$ref": "#/$defs/screenLink" } },
        "reason": { "type": "string", "minLength": 3 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "designed" } } },
          "then": { "required": ["screens"], "properties": { "screens": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "out-of-scope" } } },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
