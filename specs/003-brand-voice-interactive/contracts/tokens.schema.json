{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kudicubs.app/design-tokens/1.2.0",
  "title": "KudiCubs Design Tokens",
  "description": "Design tokens v1.2.0 (spec 003): adds $extensions on tokens (brand source/tier/status, derivation rule, needsApproval), rejectedPairs (contrast failures with their resolution) and, in 1.2.0, the tint type (a recorded colour at a recorded alpha, FR-002). Extends specs/002-ux-prototype/contracts/tokens.schema.json.",
  "type": "object",
  "required": [
    "version",
    "color",
    "typography",
    "space",
    "radius",
    "elevation",
    "size",
    "motion",
    "pairs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "color": {
      "$ref": "#/$defs/group"
    },
    "typography": {
      "$ref": "#/$defs/group"
    },
    "space": {
      "$ref": "#/$defs/group"
    },
    "radius": {
      "$ref": "#/$defs/group"
    },
    "elevation": {
      "$ref": "#/$defs/group"
    },
    "size": {
      "$ref": "#/$defs/group"
    },
    "motion": {
      "$ref": "#/$defs/group"
    },
    "font": {
      "$ref": "#/$defs/group"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "description": "Every foreground/background combination used for text or meaningful icons; checked by tools/design/check-contrast.mjs (SC-003).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fg",
          "bg",
          "usage",
          "minRatio"
        ],
        "properties": {
          "fg": {
            "$ref": "#/$defs/tokenRef"
          },
          "bg": {
            "$ref": "#/$defs/tokenRef"
          },
          "usage": {
            "type": "string"
          },
          "minRatio": {
            "enum": [
              3,
              4.5
            ]
          }
        }
      }
    },
    "rejectedPairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fg",
          "bg",
          "usage",
          "resolution"
        ],
        "properties": {
          "fg": {
            "$ref": "#/$defs/tokenRef"
          },
          "bg": {
            "$ref": "#/$defs/tokenRef"
          },
          "usage": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "tokenRef": {
      "type": "string",
      "pattern": "^\\{[a-z0-9_]+(\\.[a-z0-9_]+)+\\}$",
      "description": "Alias syntax, e.g. {color.cocoa.900}"
    },
    "token": {
      "type": "object",
      "required": [
        "$value",
        "$type",
        "$description"
      ],
      "additionalProperties": false,
      "properties": {
        "$type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "fontWeight",
            "typography",
            "shadow",
            "duration",
            "number",
            "tint"
          ]
        },
        "$value": {},
        "$description": {
          "type": "string",
          "minLength": 5
        },
        "$extensions": {
          "type": "object",
          "properties": {
            "kudicubs": {
              "type": "object",
              "properties": {
                "source": {
                  "const": "brand-guide"
                },
                "tier": {
                  "enum": [
                    "primary",
                    "supporting"
                  ]
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "provisional",
                    "assumed"
                  ]
                },
                "derivedFrom": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rule": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "needsApproval": {
                  "type": "boolean"
                },
                "notInPalette": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "$type": {
                "const": "color"
              }
            }
          },
          "then": {
            "properties": {
              "$value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  {
                    "$ref": "#/$defs/tokenRef"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "dimension"
              }
            }
          },
          "then": {
            "properties": {
              "$value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?px$"
                  },
                  {
                    "$ref": "#/$defs/tokenRef"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "duration"
              }
            }
          },
          "then": {
            "properties": {
              "$value": {
                "type": "string",
                "pattern": "^\\d+ms$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "typography"
              }
            }
          },
          "then": {
            "properties": {
              "$value": {
                "type": "object",
                "required": [
                  "fontFamily",
                  "fontWeight",
                  "fontSize",
                  "lineHeight"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "tint"
              }
            }
          },
          "then": {
            "properties": {
              "$value": {
                "type": "object",
                "required": [
                  "color",
                  "alpha"
                ],
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "$ref": "#/$defs/tokenRef"
                  },
                  "alpha": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  }
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/token"
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      }
    }
  }
}
